# ==============================
# Horror-Granny - Unity .gitignore
# Place at the root of the Unity project (next to Assets/ and ProjectSettings/)
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# ==============================

# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Keep the package manifest and lock file so packages restore on other machines
!/Packages/manifest.json
!/Packages/packages-lock.json
/Packages/*
!/Packages/manifest.json
!/Packages/packages-lock.json

# ---- Asset meta files ----
# Keep .meta files. They store asset GUIDs and references.
# Only ignore .meta files for assets that are themselves ignored.
!/[Aa]ssets/**/*.meta

# ---- Auto-generated IDE and solution files ----
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.booproj
*.svd
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Rider and JetBrains plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Unity generated meta for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Crash and system files ----
sysinfo.txt
crashlytics-build.properties

# ---- Build outputs ----
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86
*.x86_64
*.dmg
*.zip
*.tar.gz

# ---- Operating system files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- Editor backup and temp files ----
*.swp
*~
*.bak
*.orig
*.log
